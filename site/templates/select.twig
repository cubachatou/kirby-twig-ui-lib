{% extends '@docs/layout.twig' %}

{% block page_title %}
	{{ page.title }} — Kirby UI Library
{% endblock %}
{% block page_description %}
	{{ page.excerpt }}
{% endblock %}

{% block content %}
	{# ── 1. Component header ─────────────────────────────────────────── #}
	<div class="mb-14">
		<h1 class="mb-4 text-[2.25rem] font-extrabold leading-none tracking-tight text-doc-bright">{{ page.title }}</h1>
		{% if page.intro.isNotEmpty %}
			<div class="doc-intro">
				{{ page.intro|raw }}
			</div>
		{% endif %}
	</div>

	{# ── 2. Usage — installation and basic usage blocks ──────────────── #}
	{% if page.usage.isNotEmpty %}
		<section id="usage" class="mb-14 scroll-mt-20">
			<h2 class="doc-heading">Usage</h2>
			{{ page.usage.toBlocks|raw }}
		</section>
	{% endif %}

	{# ── 3. Examples — live select blocks from Kirby panel fields ─────── #}
	<section id="examples" class="mb-14 scroll-mt-20">
		<h2 class="doc-heading">Examples</h2>

		{% if page.demo_default.isNotEmpty %}
			<h3 class="doc-subheading">Default</h3>
			<p class="doc-lead">
				A basic select with a flat list of options and a placeholder.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_default.toBlocks|raw }}
				</div>
				{% if page.demo_default_code.isNotEmpty %}{{ page.demo_default_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_groups.isNotEmpty %}
			<h3 class="doc-subheading">Groups</h3>
			<p class="doc-lead">
				Use the <em>Grouped</em> display style and set a <em>Group</em> name on each option to organise items under labelled headings with separators between groups.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_groups.toBlocks|raw }}
				</div>
				{% if page.demo_groups_code.isNotEmpty %}{{ page.demo_groups_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_scrollable.isNotEmpty %}
			<h3 class="doc-subheading">Scrollable</h3>
			<p class="doc-lead">
				A select with many options scrolls within its popup automatically — no extra configuration required.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_scrollable.toBlocks|raw }}
				</div>
				{% if page.demo_scrollable_code.isNotEmpty %}{{ page.demo_scrollable_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_disabled.isNotEmpty %}
			<h3 class="doc-subheading">Disabled</h3>
			<p class="doc-lead">
				Enable the <em>Disabled</em> setting to prevent the widget from being interacted with. Individual options can also be disabled per-item.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_disabled.toBlocks|raw }}
				</div>
				{% if page.demo_disabled_code.isNotEmpty %}{{ page.demo_disabled_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{# ── Invalid — hardcoded demo; state is set by JS on form submission ── #}
		<h3 class="doc-subheading">Invalid</h3>
		<p class="doc-lead">
			When a required select is submitted without a value, JS sets <code>data-invalid</code> on the root element and <code>aria-invalid="true"</code> on the trigger. This drives the red border in SCSS and
			signals the error to assistive technology.
		</p>
		<div class="doc-example">
			<div class="doc-example-preview">
				<div class="kui-select" id="select-invalid-ex" data-kui-select data-state="closed" data-invalid>
					<button
						class="kui-select__trigger"
						id="select-invalid-ex__trigger"
						type="button"
						role="combobox"
						aria-expanded="false"
						aria-haspopup="listbox"
						aria-controls="select-invalid-ex__listbox"
						aria-labelledby="select-invalid-ex__trigger select-invalid-ex__value"
						data-kui-select-trigger
						aria-invalid="true">
						<span class="kui-select__value" id="select-invalid-ex__value" data-kui-select-value>Select an option…</span>
						<svg
							class="kui-select__chevron"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							focusable="false">
							<path d="M6 9l6 6 6-6" />
						</svg>
					</button>
					<span class="kui-select__error" role="alert">Please select an option to continue.</span>
					<div class="kui-select__content" id="select-invalid-ex__listbox" role="listbox" aria-label="Options" data-kui-select-content data-state="closed" hidden>
						<div class="kui-select__item" role="option" data-kui-select-item data-value="a" aria-selected="false" id="select-invalid-ex__option-1">
							Option A
						</div>
						<div class="kui-select__item" role="option" data-kui-select-item data-value="b" aria-selected="false" id="select-invalid-ex__option-2">
							Option B
						</div>
						<div class="kui-select__item" role="option" data-kui-select-item data-value="c" aria-selected="false" id="select-invalid-ex__option-3">
							Option C
						</div>
					</div>
				</div>
			</div>
			<div class="doc-code" data-copy-block>
				<pre>
					<code class="language-plaintext">
						# JS sets these on submit when the select is required and empty: # data-invalid → on the root element (drives the red border) # aria-invalid="true" → on the trigger button (signals the
						error to AT)
					</code>
				</pre>
			</div>
		</div>
	</section>

	{# ── 4. Body blocks — edit content in the Kirby panel ─────────────── #}
	{{ page.body.toBlocks|raw }}
{% endblock %}
