{% extends '@docs/layout.twig' %}

{% block page_title %}
	{{ page.title }} — Kirby UI Library
{% endblock %}
{% block page_description %}
	{{ page.excerpt }}
{% endblock %}

{% block content %}
	{# ── 1. Component header ──────────────────────────────────────────────── #}
	<div class="mb-14">
		<h1 class="mb-4 text-[2.25rem] font-extrabold leading-none tracking-tight text-doc-bright">{{ page.title }}</h1>
		{% if page.intro.isNotEmpty %}
			<div class="doc-intro">
				{{ page.intro|raw }}
			</div>
		{% endif %}
	</div>

	{# ── 2. Usage — installation and basic usage blocks ───────────────────── #}
	{% if page.usage.isNotEmpty %}
		<section id="usage" class="mb-14 scroll-mt-20">
			<h2 class="doc-heading">Usage</h2>
			{{ page.usage.toBlocks|raw }}
		</section>
	{% endif %}

	{# ── 3. Examples ─────────────────────────────────────────────────────── #}
	<section id="examples" class="mb-14 scroll-mt-20">
		<h2 class="doc-heading">Examples</h2>

		{% if page.demo.isNotEmpty %}
			<h3 class="doc-subheading">Default</h3>
			<p class="doc-lead">
				A standard pill-style tab list. One tab is active at a time.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo.toBlocks|raw }}
				</div>
				{% if page.demo_code.isNotEmpty %}{{ page.demo_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_line.isNotEmpty %}
			<h3 class="doc-subheading">Line</h3>
			<p class="doc-lead">
				Use <em>Display Style: Line</em> in the panel for an underline indicator.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_line.toBlocks|raw }}
				</div>
				{% if page.demo_line_code.isNotEmpty %}{{ page.demo_line_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_vertical.isNotEmpty %}
			<h3 class="doc-subheading">Vertical</h3>
			<p class="doc-lead">
				Use <em>Display Style: Vertical</em> for a stacked tab list. Collapses to horizontal below 640 px.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_vertical.toBlocks|raw }}
				</div>
				{% if page.demo_vertical_code.isNotEmpty %}{{ page.demo_vertical_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_disabled.isNotEmpty %}
			<h3 class="doc-subheading">Disabled</h3>
			<p class="doc-lead">
				Use the <em>Disabled</em> toggle on an item to prevent that tab from being selected.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_disabled.toBlocks|raw }}
				</div>
				{% if page.demo_disabled_code.isNotEmpty %}{{ page.demo_disabled_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}
	</section>

	{# ── 4. Body blocks — edit in the Kirby panel ─────────────────────────── #}
	{{ page.body.toBlocks|raw }}
{% endblock %}
