{% extends '@docs/layout.twig' %}

{% block page_title %}
	{{ page.title }} — Kirby UI Library
{% endblock %}
{% block page_description %}
	{{ page.excerpt }}
{% endblock %}

{% block content %}
	{# ── 1. Component header ─────────────────────────────────────────── #}
	<div class="mb-14">
		<h1 class="mb-4 text-[2.25rem] font-extrabold leading-none tracking-tight text-doc-bright">{{ page.title }}</h1>
		{% if page.intro.isNotEmpty %}
			<div class="doc-intro">
				{{ page.intro|raw }}
			</div>
		{% endif %}
	</div>

	{# ── 2. Usage ────────────────────────────────────────────────────── #}
	{% if page.usage.isNotEmpty %}
		<section id="usage" class="mb-14 scroll-mt-20">
			<h2 class="doc-heading">Usage</h2>
			{{ page.usage.toBlocks|raw }}
		</section>
	{% endif %}

	{# ── 3. Examples ─────────────────────────────────────────────────── #}
	<section id="examples" class="mb-14 scroll-mt-20">
		<h2 class="doc-heading">Examples</h2>

		{% if page.demo.isNotEmpty %}
			<h3 class="doc-subheading">Default</h3>
			<p class="doc-lead">
				A standard modal dialog with a × close button in the top-right corner. Closes on Escape and optionally on backdrop click.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo.toBlocks|raw }}
				</div>
				{% if page.demo_code.isNotEmpty %}{{ page.demo_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_custom_close.isNotEmpty %}
			<h3 class="doc-subheading">Custom Close Button</h3>
			<p class="doc-lead">
				The header × button is removed. The close control lives in the footer blocks — full label and layout control for the content author.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_custom_close.toBlocks|raw }}
				</div>
				{% if page.demo_custom_close_code.isNotEmpty %}{{ page.demo_custom_close_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_no_close.isNotEmpty %}
			<h3 class="doc-subheading">No Close Button</h3>
			<p class="doc-lead">
				No close button is rendered. Escape key and backdrop click (when enabled) remain the only exits. Use sparingly — users must always have a predictable escape route.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_no_close.toBlocks|raw }}
				</div>
				{% if page.demo_no_close_code.isNotEmpty %}{{ page.demo_no_close_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_sticky_footer.isNotEmpty %}
			<h3 class="doc-subheading">Sticky Footer</h3>
			<p class="doc-lead">
				The body region is independently scrollable while the footer action bar remains pinned at the bottom of the dialog at all times.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_sticky_footer.toBlocks|raw }}
				</div>
				{% if page.demo_sticky_footer_code.isNotEmpty %}{{ page.demo_sticky_footer_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}

		{% if page.demo_scrollable.isNotEmpty %}
			<h3 class="doc-subheading">Scrollable Content</h3>
			<p class="doc-lead">
				The body scrolls within a capped max-height. Use for long-form content like terms of service, changelogs, or image galleries.
			</p>
			<div class="doc-example">
				<div class="doc-example-preview">
					{{ page.demo_scrollable.toBlocks|raw }}
				</div>
				{% if page.demo_scrollable_code.isNotEmpty %}{{ page.demo_scrollable_code.toBlocks|raw }}{% endif %}
			</div>
		{% endif %}
	</section>

	{# ── 4. Body blocks — edit content in the Kirby panel ─────────────── #}
	{{ page.body.toBlocks|raw }}
{% endblock %}
