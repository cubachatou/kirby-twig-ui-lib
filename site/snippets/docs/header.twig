<header class="doc-header" id="doc-header">
	<div class="doc-header-inner">
		{# ── Mobile hamburger ──────────────────────────────────────────────── #}
		<button class="doc-hamburger" aria-label="Open navigation menu" aria-expanded="false" aria-controls="doc-sidebar" data-sidebar-toggle>
			<span class="doc-hamburger-bar"></span>
			<span class="doc-hamburger-bar"></span>
			<span class="doc-hamburger-bar"></span>
		</button>

		{# ── Logo / wordmark ───────────────────────────────────────────────── #}
		<a href="/" class="doc-logo" aria-label="Kirby UI Library home">
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="doc-logo-icon">
				<rect width="20" height="20" rx="4" fill="currentColor" opacity="0.12" />
				<path d="M6 5h8M6 10h8M6 15h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
			</svg>
			<span class="doc-logo-text">Kirby UI Library</span>
		</a>

		{# ── Right-side controls ───────────────────────────────────────────── #}
		<div class="doc-header-controls">
			{# Search trigger #}
			<button class="doc-search-trigger" aria-label="Search documentation" aria-keyshortcuts="Control+K Meta+K" data-search-open>
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M6.5 11a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm3.25-1.311 2.94 2.94a.75.75 0 0 1-1.06 1.06l-2.94-2.94A5.96 5.96 0 0 1 6.5 12 6 6 0 1 1 12.5 6a5.96 5.96 0 0 1-1.75 4.189Z"
						fill="currentColor" />
				</svg>
				<span class="doc-search-trigger-label">Search…</span>
				<kbd class="doc-search-kbd"><span>⌘</span>K</kbd>
			</button>

			{# Dark / light toggle #}
			<button class="doc-theme-toggle" aria-label="Toggle dark/light mode" data-theme-toggle title="Toggle theme">
				{# Sun icon (visible in dark mode) #}
				<svg class="doc-theme-icon doc-theme-icon--sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5" />
					<path
						d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round" />
				</svg>
				{# Moon icon (visible in light mode) #}
				<svg class="doc-theme-icon doc-theme-icon--moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6.001 6.001 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
				</svg>
			</button>

			{# GitHub link #}
			<a href="https://github.com/your-vendor/kirby-kui" target="_blank" rel="noopener noreferrer" class="doc-header-link" aria-label="View source on GitHub (opens in new tab)">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
				</svg>
			</a>
		</div>
	</div>
</header>
